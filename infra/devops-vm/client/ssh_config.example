# Фрагмент ~/.ssh/config хостовой системы (закрытый ключ ~/.ssh/devops_vm в репозиторий НЕ помещается)
Host devops
    HostName 127.0.0.1
    Port 2222
    User devops
    IdentityFile ~/.ssh/devops_vm
    IdentitiesOnly yes

Host devops.local
    HostName devops.local
    Port 2222
    User devops
    IdentityFile ~/.ssh/devops_vm
    IdentitiesOnly yes
